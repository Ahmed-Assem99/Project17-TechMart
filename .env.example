# Copy this file to .env.local and fill in the values.
# Never commit .env or .env.local: they are ignored by git on purpose.

# Base URL of the e-commerce API (public: it is sent to the browser)
NEXT_PUBLIC_BASE_URL=https://ecommerce.routemisr.com

# Signs and encrypts the login cookies. SECRET. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-string

# Address of this site, used by NextAuth
NEXTAUTH_URL=http://localhost:3000
